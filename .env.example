# Copy this file to .env and fill in your keys.

# Required — get one at https://console.anthropic.com (Settings → API keys)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model to use (local dev only; deployed version reads from Worker secret)
ANTHROPIC_MODEL=claude-sonnet-4-6

# Gmail — for sending emails locally during demo
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password-here

# Resend — only needed for the deployed Cloudflare Worker version (not local dev)
RESEND_API_KEY=re_your-key-here

# Local dev server port
PORT=3000
